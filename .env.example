# MULTI-CHANNEL NEWS NOTIFICATIONS (OPTIONAL)
# Kirim notifikasi otomatis saat ada rilis berita baru di news.bsi.ac.id
NEWS_WEBHOOK_INTERVAL=600

# 1. Custom Webhook (Payload JSON generik untuk bot WhatsApp Ciel / backend custom)
