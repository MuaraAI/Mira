# SERVER CONFIG
HOST=127.0.0.1
PORT=8300
REDIS_URL=redis://127.0.0.1:6379/2

# SECURITY & REMOTE ACCESS
# Wajib diisi di produksi untuk memproteksi API dari akses luar tanpa izin.
API_KEY=
# CORS: di produksi, ganti ke explicit origins (pisah koma), contoh:
# Comma-separated browser origins. Never use * with credentialed cookies.
ALLOWED_ORIGINS=https://mira.muaraai.com,https://ubsi-api.muaraai.com
TRUSTED_PROXIES=127.0.0.1
ROOT_PATH=/v1/mira

# SESSION LOGIN BSI (Dashboard)
# Cookie domain untuk SSO antar subdomain (produksi: .muaraai.com, kosongkan untuk localhost)
SESSION_COOKIE_DOMAIN=
# SQLite WAL untuk config channel notifikasi user
SQLITE_DB_PATH=data/ubsi.db
# Sesi SIAKAD/MyBest kampus habis ~15 menit; server login ulang otomatis sebelum batas ini (detik)
UPSTREAM_SESSION_MAX_AGE=780

# SCRAPER PROXY CONFIGURATION (OPTIONAL)
# Format didukung: ip:port, ip:port:user:pass, http://user:pass@ip:port, socks5://ip:port
# 1. Single Proxy:
SCRAPER_PROXY=
# 2. Rotating Proxy Pool (dipisahkan koma, otomatis sticky per-NIM untuk sesi login):
SCRAPER_PROXY_POOL=

# PWA Web Push (VAPID / RFC 8291-8292) - generate via scripts/generate_vapid_keys.py
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=admin@muaraai.com
# Notifikasi kelas segera mulai dan pengingat absen dicek tiap N detik (minimal 30)
REALTIME_NOTIFY_INTERVAL=60

# MIRA SOCIAL V3 (SUPABASE POSTGRES & REALTIME)
SUPABASE_URL=https://duzehjktvbuqczjubshy.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
