# SERVER CONFIG
HOST=127.0.0.1
PORT=8300
REDIS_URL=redis://127.0.0.1:6379/2

# SECURITY & REMOTE ACCESS
# Wajib diisi di produksi untuk memproteksi API dari akses luar tanpa izin.
API_KEY=
# CORS: di produksi, ganti ke explicit origins (pisah koma), contoh:
# Comma-separated browser origins. Never use * with credentialed cookies.
ALLOWED_ORIGINS=https://mira.muaraai.com,https://ubsi-api.muaraai.com
# IP atau CIDR proxy tepercaya (mis. edge Cloudflare). Header CF-Connecting-IP/X-Real-IP
# hanya dipercaya bila koneksi datang dari salah satu entri ini.
TRUSTED_PROXIES=127.0.0.1
ROOT_PATH=/v1/mira

# SESSION LOGIN BSI (Dashboard)
# Cookie domain untuk SSO antar subdomain (produksi: .muaraai.com, kosongkan untuk localhost)
SESSION_COOKIE_DOMAIN=
# SQLite WAL untuk config channel notifikasi user
SQLITE_DB_PATH=data/ubsi.db
# Password default kampus yang diingatkan untuk diganti (dipisahkan koma)
CAMPUS_DEFAULT_PASSWORDS=

# Saklar SIAKAD: false = seluruh endpoint SIAKAD balas 503 SIAKAD_DISABLED + CTA.
# Set true lalu restart untuk mengaktifkan lagi endpoint SIAKAD (level API).
SIAKAD_ENABLED=false
# Tautan CTA yang dikirim ke klien saat SIAKAD dimatikan.
SIAKAD_CTA_URL=https://students.bsi.ac.id

# Maintenance mode: true = API + dashboard diblokir 503 MAINTENANCE.
MAINTENANCE_MODE=false
# NIM yang tetap boleh login/dashboard saat maintenance (pisahkan dengan koma).
MAINTENANCE_WHITELIST_NIMS=
# Teks yang tampil di popup login dan halaman terkunci.
MAINTENANCE_MESSAGE=Mohon maaf, Mira untuk saat ini sedang maintenance.
MAINTENANCE_REASON=Pihak BSI mengubah CAPTCHA MyBest/SIAKAD dan sedang kami perbaiki, jadi Mira belum bisa dipakai.
# SCRAPER PROXY CONFIGURATION (OPTIONAL)
# Format didukung: ip:port, ip:port:user:pass, http://user:pass@ip:port, socks5://ip:port
# 1. Single Proxy:
SCRAPER_PROXY=
# 2. Rotating Proxy Pool (dipisahkan koma, otomatis sticky per-NIM untuk sesi login):
SCRAPER_PROXY_POOL=

# PWA Web Push (VAPID / RFC 8291-8292) - generate via scripts/generate_vapid_keys.py
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=admin@muaraai.com
# Notifikasi kelas segera mulai dan pengingat absen dicek tiap N detik (minimal 30)
REALTIME_NOTIFY_INTERVAL=60

# MIRA SOCIAL V3 (SUPABASE POSTGRES & REALTIME)
SUPABASE_URL=https://duzehjktvbuqczjubshy.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
# Wire protocol Postgres (Supabase Dashboard -> Connect -> Session pooler, port 5432).
# Diisi di produksi: social 100% tersimpan di Supabase. Kosongkan di lokal/test (fallback SQLite).
SUPABASE_DB_URL=
