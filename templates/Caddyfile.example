# UBSI API — Caddy Reverse Proxy Template (api.muaraai.com)
# Lokasi file di VPS: /etc/caddy/Caddyfile
#
# Snippet security_headers (HSTS, CSP, X-Frame-Options, dll) wajib ada di
# Caddyfile produksi dan di-import di setiap blok site (lihat blok di bawah).

(security_headers) {
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        Content-Security-Policy "default-src none"
        Permissions-Policy "geolocation=(), microphone=(), camera=()"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
    }
}

api.muaraai.com {
    import security_headers

    # Project: Mira API (Twin Gateway /v1/mira/* -> port 8300 / 8350)
    handle_path /v1/mira/docs* {
        rewrite * /docs{path}
        reverse_proxy 127.0.0.1:8300
    }
    handle_path /v1/mira/openapi.json* {
        rewrite * /openapi.json
        reverse_proxy 127.0.0.1:8300
    }
    handle_path /v1/mira/health* {
        rewrite * /health
        reverse_proxy 127.0.0.1:8300
    }
    handle_path /v1/mira/v1/* {
        rewrite * /v1{path}
        reverse_proxy 127.0.0.1:8300
    }
    handle_path /v1/mira/mcp* {
        rewrite * /mcp{path}
        reverse_proxy 127.0.0.1:8350
    }
    handle_path /v1/mira/* {
        rewrite * /v1{path}
        reverse_proxy 127.0.0.1:8300
    }

    # Project: UBSI API (Legacy Alias /v1/ubsi-api/*)
    handle_path /v1/ubsi-api/docs* {
        rewrite * /docs{path}
        reverse_proxy 127.0.0.1:8300
    }
    handle_path /v1/ubsi-api/openapi.json* {
        rewrite * /openapi.json
        reverse_proxy 127.0.0.1:8300
    }
    handle_path /v1/ubsi-api/health* {
        rewrite * /health
        reverse_proxy 127.0.0.1:8300
    }
    handle_path /v1/ubsi-api/v1/* {
        rewrite * /v1{path}
        reverse_proxy 127.0.0.1:8300
    }
    handle_path /v1/ubsi-api/mcp* {
        rewrite * /mcp{path}
        reverse_proxy 127.0.0.1:8350
    }
    handle_path /v1/ubsi-api/* {
        rewrite * /v1{path}
        reverse_proxy 127.0.0.1:8300
    }

    handle {
        respond "Muara AI Unified API Gateway (Status: Operational)" 200
    }
}
