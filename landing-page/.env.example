# UBSI API Dashboard & Landing Page

# [WAJIB] URL backend UBSI API untuk client dashboard (tanpa trailing slash)
# Contoh lokal: http://127.0.0.1:8300
# Contoh produksi: https://api.muaraai.com/v1/ubsi-api
NEXT_PUBLIC_API_URL=

# [OPSIONAL] Konfigurasi server-side proxy untuk halaman /recap
# Diperlukan jika landing-page dideploy mandiri di Vercel tanpa berkas .env root
UBSI_BACKEND_URL=
UBSI_API_KEY=
